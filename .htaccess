# Video MIME types — required for iOS Safari autoplay
AddType video/mp4 .mp4 .m4v
AddType video/quicktime .mov

# Enable byte-range requests so iOS can stream video
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|m4v|mov)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

# Caching
# Pages, scripts and styles: the browser always checks for a newer version
# (a quick "not modified" if nothing changed), so updates show up right away.
# Images and videos: kept for a day, so repeat visits and Hostinger's CDN don't
# download them again every time (this is what makes the videos load fast on phones).
# If you replace an image or video under the SAME file name, some visitors can
# see the old one for up to a day; give it a new file name to avoid that.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
  Header unset Pragma
  Header unset Expires
  <FilesMatch "\.(mp4|m4v|mov|webm|jpe?g|png|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Short ad link: dakevisuals.com/annonce goes to the /annoncer landing page.
# The ad's UTM parameters (?utm_source=…) are carried over automatically.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/annonce/?$ /annoncer/
</IfModule>
